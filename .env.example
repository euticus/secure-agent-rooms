# ---- Required in production -------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
BOOTH_AUDIT_KEY=

# Postgres. Managed providers usually need ?sslmode=require
# DATABASE_URL=postgres://booth:booth_local_dev@localhost:5432/booth

# ---- Environment ------------------------------------------------------------
BOOTH_ENV=production
# Passwordless dev sign-in. Cannot be enabled when BOOTH_ENV=production.
BOOTH_DEV_AUTH=false
# Optional closed-beta gate: when set, registration requires this exact key.
# BOOTH_SIGNUP_KEY=

# ---- URLs -------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
# Read at runtime by the web service and served to the browser via /config.js.
# Changing it is a restart, not a rebuild.
API_BASE_URL=http://localhost:4000
# Build-time fallback, used when API_BASE_URL is unset (local development).
NEXT_PUBLIC_API_BASE=http://localhost:4000

# ---- Local compose ----------------------------------------------------------
POSTGRES_PASSWORD=booth_local_dev

# ---- Email notifications ----------------------------------------------------
# With docker compose these default to the bundled Mailpit (UI on :8025).
# For production, point them at your provider and set a deliverable From address.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=Secure Agent Rooms <no-reply@localhost>
# Public URL used in email links (falls back to WEB_ORIGIN).
APP_URL=http://localhost:3000
# Set BOOTH_EMAIL=console to log emails instead of sending, or =off to disable.
# BOOTH_EMAIL=console

# ---- Optional: hosted agent credentials -------------------------------------
# Referenced by agent connections as "env:ANTHROPIC_API_KEY" — the platform
# stores only the reference, never the value.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
